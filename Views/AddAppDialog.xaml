<Window x:Class="QuickWheel.Views.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une app"
        Width="460" Height="560" ResizeMode="CanResize" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Ink}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiText}" FontSize="13">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText" Style="{StaticResource H1}" Text="Ajouter une app" TextWrapping="Wrap" />
            <TextBlock x:Name="IntroText" Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="Choisis une app ouverte, ou écris le nom de son processus. Elle aura sa propre roue, avec les raccourcis globaux déjà dedans." />
            <TextBlock Style="{StaticResource Field}" Text="Apps ouvertes" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel x:Name="NamePanel">
                <TextBlock Style="{StaticResource Field}" Text="Nom affiché" />
                <TextBox x:Name="NameBox" />
            </StackPanel>
            <TextBlock Style="{StaticResource Field}" Text="Processus (séparés par des virgules, sans .exe)" />
            <TextBox x:Name="ProcessBox" FontFamily="{StaticResource KeysFont}" />
            <TextBlock x:Name="ErrorText" Foreground="#E08A7A" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Ajouter l'app" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="RunningList" SelectionChanged="Running_Selected" Background="{StaticResource Surface}"
                 BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,3">
                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Dim}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
