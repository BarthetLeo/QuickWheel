<Window x:Class="QuickWheel.Views.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir une icône"
        Width="640" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Ink}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiText}" FontSize="13">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Utiliser cette icône" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
            <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <ContentControl x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="PreviewName" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
            <TabItem Header="Material Design">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top">
                        <ComboBox x:Name="CategoryBox" DockPanel.Dock="Right" Width="200" Margin="8,0,0,0"
                                  DisplayMemberPath="Label" SelectionChanged="Category_Changed" />
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" />
                    </DockPanel>
                    <TextBlock x:Name="CountText" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,8,0,8" />
                    <ListBox x:Name="IconRows" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="48" Height="48" Margin="0,0,4,4" Padding="0" Click="Icon_Click"
                                                    MouseDoubleClick="Icon_DoubleClick" ToolTip="{Binding Name}" Tag="{Binding}">
                                                <Path Data="{Binding Geometry}" Fill="{StaticResource TextBrush}" Width="24" Height="24" Stretch="Uniform" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="Image">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Hint}" Text="Une image PNG, JPG, ICO ou BMP. Elle est lue depuis son emplacement, ne la déplace pas ensuite." />
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseImage_Click" Margin="8,0,0,0" />
                        <TextBox x:Name="ImagePath" TextChanged="ImagePath_Changed" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Icône d'un programme">
                <DockPanel Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Hint}" Text="Récupère l'icône d'un .exe (ou de n'importe quel fichier)." />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseExe_Click" Margin="8,0,0,0" />
                            <TextBox x:Name="ExePath" TextChanged="ExePath_Changed" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Field}" Text="Ou une app ouverte en ce moment" Margin="0,16,0,6" />
                    </StackPanel>
                    <ListBox x:Name="RunningList" SelectionChanged="Running_Selected" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="Texte ou emoji">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Hint}" Text="Un ou deux caractères. Win + . ouvre le sélecteur d'emojis de Windows (affichés en monochrome)." />
                    <TextBox x:Name="TextIcon" Margin="0,12,0,0" FontSize="22" Width="120" HorizontalAlignment="Left"
                             TextAlignment="Center" MaxLength="4" TextChanged="TextIcon_Changed"
                             FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
