<Window x:Class="QuickWheel.Views.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickWheel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="400" Height="400"
        Cursor="Arrow">
    <!-- Fond presque transparent mais cliquable : un clic n'importe où sur l'écran est capté par le menu -->
    <Canvas x:Name="Root">
        <Canvas x:Name="Wheel">
            <Canvas.RenderTransform>
                <ScaleTransform x:Name="WheelScale" ScaleX="1" ScaleY="1" />
            </Canvas.RenderTransform>
        </Canvas>
    </Canvas>
</Window>
