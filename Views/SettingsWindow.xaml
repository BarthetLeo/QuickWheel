<Window x:Class="QuickWheel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:QuickWheel.Models"
        Title="QuickWheel"
        Width="1320" Height="820" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ink}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiText}" FontSize="13">

    <Window.Resources>
        <!-- Visible seulement pour un type d'étape donné -->
        <Style x:Key="ForKeys" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:ActionType.Keys}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForLaunch" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:ActionType.Launch}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForText" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:ActionType.Text}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForCommand" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:ActionType.Command}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForWait" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:ActionType.Wait}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForClick" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:ActionType.Click}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- ================= Colonne 1 : les roues ================= -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,6,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ContentControl x:Name="BrandLogo" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="QuickWheel" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Roues" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                               Text="Chaque app a sa roue. La roue globale s'ouvre partout ailleurs." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="Ajouter une app" Click="AddApp_Click" HorizontalAlignment="Stretch" />
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Content="Importer…" Click="Import_Click" Margin="0,0,4,0" />
                        <Button x:Name="ExportButton" Content="Exporter…" Click="Export_Click" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>
                <ListBox x:Name="WheelList" Background="Transparent" BorderThickness="0" SelectionChanged="WheelList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,4">
                                <ContentControl Content="{Binding IconElement}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Dim}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Colonne 2 : éditeur visuel ================= -->
        <Grid Grid.Column="1" Margin="6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Fil d'Ariane + ajout -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Ajouter un dossier" Click="AddFolder_Click" Margin="0,0,8,0" />
                    <Button Content="Ajouter un raccourci" Style="{StaticResource Primary}" Click="AddShortcut_Click" />
                </StackPanel>
                <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>

            <!-- La roue -->
            <Border Grid.Row="2" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Ink}" ClipToBounds="True">
                <Grid>
                    <Grid x:Name="CanvasHost" Background="{StaticResource Ink}" Cursor="Arrow"
                          MouseLeftButtonDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp"
                          MouseLeave="Canvas_MouseLeave" SizeChanged="Canvas_SizeChanged">
                        <Canvas x:Name="EditorCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScale" />
                                    <TranslateTransform x:Name="CanvasOffset" />
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="CanvasHint" Style="{StaticResource Hint}" Margin="14,0,14,12" VerticalAlignment="Bottom"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Anneaux -->
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                <StackPanel x:Name="RingsPanel" Orientation="Horizontal" />
            </ScrollViewer>
        </Grid>

        <!-- ================= Colonne 3 : inspecteur ================= -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="6,0,0,0" Padding="0">
            <Grid>
                <!-- Réglages de la roue affichée (quand aucune case n'est choisie) -->
                <ScrollViewer x:Name="WheelInspector" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="18">
                        <DockPanel>
                            <Button x:Name="WheelIconButton" DockPanel.Dock="Left" Width="64" Height="64" Padding="0" Click="PickWheelIcon_Click"
                                    ToolTip="Changer l'icône de la roue" Margin="0,0,14,0">
                                <ContentControl x:Name="WheelIconPreview" />
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Field}" Margin="0,0,0,4" Text="Nom de la roue" />
                                <TextBox x:Name="WheelNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="15"
                                         TextChanged="AppField_Changed" />
                                <TextBlock x:Name="GlobalNameText" Text="Global" FontSize="15" FontWeight="SemiBold" Visibility="Collapsed" />
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="WheelIconActions" Margin="0,10,0,0">
                            <Button Content="Importer une image…" Click="ImportWheelImage_Click" Margin="0,0,8,6" />
                            <Button Content="Icône de l'app" Click="ResetWheelIcon_Click" Margin="0,0,8,6"
                                    ToolTip="Utiliser l'icône du programme (l'app doit être ouverte, sinon choisis son .exe)" />
                        </WrapPanel>

                        <TextBlock x:Name="WheelStats" Style="{StaticResource Hint}" Margin="0,12,0,0" />

                        <StackPanel x:Name="WheelAppSection">
                            <TextBlock Style="{StaticResource H2}" Text="Apps qui utilisent cette roue" />
                            <TextBox Text="{Binding ProcessNames, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource KeysFont}"
                                     TextChanged="ProcessField_Changed" ToolTip="Noms de processus séparés par des virgules, sans .exe" />
                            <TextBlock x:Name="ProcessClash" Foreground="#E08A7A" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Noms de processus séparés par des virgules (sans .exe). Une app ne peut avoir qu'une roue." />
                            <Button Content="Ajouter une app à cette roue…" Click="AddAppToWheel_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="GlobalHint" Style="{StaticResource Hint}" Margin="0,14,0,0" Visibility="Collapsed"
                                   Text="La roue globale s'ouvre dans toutes les apps qui n'ont pas leur propre roue. Ses raccourcis apparaissent aussi dans les roues des apps." />

                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ExportWheelButton" Content="Exporter cette roue…" Click="Export_Click" Margin="0,0,8,0" />
                                <Button x:Name="RemoveAppButton" Content="Supprimer cette roue" Style="{StaticResource Quiet}" Foreground="#E08A7A"
                                        Click="RemoveApp_Click" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                   Text="Clique une case de la roue pour modifier ce raccourci." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyInspector" VerticalAlignment="Center" Margin="32">
                    <TextBlock Style="{StaticResource H2}" Text="Aucune case choisie" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center"
                               Text="Clique une case de la roue pour la modifier, ou ajoute un raccourci." />
                </StackPanel>

                <ScrollViewer x:Name="Inspector" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="18">
                        <!-- Icône + libellé -->
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Width="64" Height="64" Padding="0" Click="PickIcon_Click" ToolTip="Changer l'icône" Margin="0,0,14,0">
                                <ContentControl x:Name="IconPreview" />
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Field}" Margin="0,0,0,4" Text="Libellé" />
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Style="{StaticResource H2}" Text="Couleur de la case" />
                        <WrapPanel x:Name="SwatchPanel" />
                        <DockPanel Margin="0,2,0,0">
                            <Button DockPanel.Dock="Left" Content="Par défaut" Style="{StaticResource Quiet}" Click="DefaultColor_Click" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Color, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" FontFamily="{StaticResource KeysFont}"
                                     ToolTip="Couleur personnalisée, par ex. #2E3B4E" LostFocus="Color_LostFocus" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Field}" Text="Couleur de l'icône" />
                        <WrapPanel x:Name="IconColorPanel" />

                        <!-- Portée -->
                        <StackPanel x:Name="ScopeSection">
                            <TextBlock Style="{StaticResource H2}" Text="Apparaît dans" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Changer…" Click="ChangeScope_Click" />
                                <TextBlock x:Name="ScopeSummary" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Type -->
                        <TextBlock Style="{StaticResource H2}" Text="Ce que fait la case" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="KindAction" Content="Lance des actions" GroupName="Kind" Margin="0,0,18,0" Checked="Kind_Checked" />
                            <RadioButton x:Name="KindFolder" Content="Ouvre une sous-roue" GroupName="Kind" Checked="Kind_Checked" />
                        </StackPanel>

                        <!-- Dossier -->
                        <StackPanel x:Name="FolderSection" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Dans la roue, la sous-roue s'ouvre quand tu restes un instant sur cette case. Vise le centre pour revenir." />
                            <Button Content="Modifier le contenu du dossier" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- Étapes (macro) -->
                        <StackPanel x:Name="ActionsSection">
                            <TextBlock Style="{StaticResource Field}" Text="Étapes, exécutées dans l'ordre" Margin="0,14,0,6" />
                            <ListBox x:Name="StepsList" ItemsSource="{Binding Actions}" MinHeight="60" MaxHeight="170"
                                     Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                     SelectionChanged="StepsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Margin="0,2" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Margin="0,6,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="▲" Style="{StaticResource Quiet}" Click="StepUp_Click" ToolTip="Monter l'étape" />
                                    <Button Content="▼" Style="{StaticResource Quiet}" Click="StepDown_Click" ToolTip="Descendre l'étape" />
                                    <Button Content="Retirer" Style="{StaticResource Quiet}" Click="StepRemove_Click" />
                                </StackPanel>
                                <TextBlock Text="Ajouter :" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Touches" Tag="{x:Static m:ActionType.Keys}" Click="AddStep_Click" Margin="0,0,6,6" />
                                <Button Content="Texte" Tag="{x:Static m:ActionType.Text}" Click="AddStep_Click" Margin="0,0,6,6" />
                                <Button Content="Lancer" Tag="{x:Static m:ActionType.Launch}" Click="AddStep_Click" Margin="0,0,6,6" />
                                <Button Content="PowerShell" Tag="{x:Static m:ActionType.Command}" Click="AddStep_Click" Margin="0,0,6,6" />
                                <Button Content="Clic" Tag="{x:Static m:ActionType.Click}" Click="AddStep_Click" Margin="0,0,6,6" />
                                <Button Content="Pause" Tag="{x:Static m:ActionType.Wait}" Click="AddStep_Click" Margin="0,0,6,6" />
                            </WrapPanel>
                            <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="8" BorderBrush="{StaticResource Brass}" BorderThickness="1">
                                <DockPanel>
                                    <Button x:Name="RecordButton" DockPanel.Dock="Right" Content="● Enregistrer" Style="{StaticResource Primary}"
                                            Click="Record_Click" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Enregistrer une séquence" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="Clique et tape comme d'habitude, puis Échap. La séquence est rejouée d'un coup, sans tes temps d'attente." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Éditeur de l'étape sélectionnée -->
                            <Border x:Name="StepEditor" Margin="0,8,0,0" Padding="12" CornerRadius="8" Background="{StaticResource Raised}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    DataContext="{Binding SelectedItem, ElementName=StepsList}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource ForKeys}">
                                        <TextBlock Style="{StaticResource Field}" Margin="0,0,0,4" Text="Clique dans la case puis fais le combo" />
                                        <TextBox x:Name="KeyRecorder" Style="{StaticResource Recorder}" Text="{Binding Value, Mode=OneWay}"
                                                 PreviewKeyDown="KeyRecorder_PreviewKeyDown" GotKeyboardFocus="Recorder_GotFocus" LostKeyboardFocus="Recorder_LostFocus" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <CheckBox x:Name="AppendStep" Content="Ajouter à la suite (séquence)" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Content="Effacer" Style="{StaticResource Quiet}" Click="ClearKeys_Click" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Field}" Text="Ou écris-le" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource KeysFont}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="Ctrl+Shift+S, ou une séquence : Ctrl+K, Ctrl+C. Les combos réservés par Windows (Win+D…) s'écrivent à la main." />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource ForLaunch}">
                                        <TextBlock Style="{StaticResource Field}" Margin="0,0,0,4" Text="Programme, fichier, dossier ou adresse web" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Parcourir…" Click="Browse_Click" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Field}" Text="Arguments (facultatif)" />
                                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="notepad.exe, https://github.com, %USERPROFILE%\Documents, ms-settings:" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource ForText}">
                                        <TextBlock Style="{StaticResource Field}" Margin="0,0,0,4" Text="Texte à taper" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                                 TextWrapping="Wrap" MinHeight="90" VerticalContentAlignment="Top" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Chaque retour à la ligne est tapé comme Entrée." />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource ForCommand}">
                                        <TextBlock Style="{StaticResource Field}" Margin="0,0,0,4" Text="Commande PowerShell" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="70" VerticalContentAlignment="Top" FontFamily="{StaticResource KeysFont}" />
                                        <CheckBox Content="Afficher la fenêtre PowerShell" IsChecked="{Binding ShowWindow}" Margin="0,8,0,0" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource ForClick}">
                                        <TextBlock Style="{StaticResource Field}" Margin="0,0,0,4" Text="Position à l'écran (pixels)" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Choisir à l'écran…" Click="PickPoint_Click" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource KeysFont}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Field}" Text="Bouton" />
                                        <ComboBox x:Name="ClickButtonBox" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Button}" Width="160" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="« Choisir à l'écran » : la fenêtre se cache, clique sur le bouton voulu (Échap pour annuler). QuickWheel retient ce bouton et le retrouve même si la fenêtre a bougé ; s'il ne le reconnaît pas, il clique à la position (x,y). La souris revient à sa place après le raccourci." />
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" Visibility="{Binding ShowTargetInfo, Converter={StaticResource BoolToVis}}" Padding="10,8" CornerRadius="6" Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Oublier" Style="{StaticResource Quiet}" Click="ForgetTarget_Click"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Ne plus viser cet élément (position exacte pour un clic, curseur actuel pour du texte)"
                                                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding TargetText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>

                                    <StackPanel Style="{StaticResource ForWait}">
                                        <TextBlock Style="{StaticResource Field}" Margin="0,0,0,4" Text="Durée de la pause (millisecondes)" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Pied -->
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="TestButton" DockPanel.Dock="Left" Content="Tester dans 3 s" Click="Test_Click" Margin="0,0,10,0" />
                                    <TextBlock x:Name="TestStatus" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                               Text="Passe sur l'app visée pendant le décompte." />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Dupliquer" Click="Duplicate_Click" Margin="0,0,8,0" />
                                    <Button x:Name="DeleteButton" Content="Supprimer" Style="{StaticResource Quiet}" Foreground="#E08A7A" Click="Delete_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= Barre du bas : réglages généraux ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Fermer sans enregistrer" Style="{StaticResource Quiet}" Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Content="Enregistrer" Style="{StaticResource Primary}" Click="Save_Click" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource Field}" Margin="0,0,0,3" Text="Touche d'ouverture" />
                        <TextBox x:Name="TriggerBox" Style="{StaticResource Recorder}" Width="160"
                                 PreviewKeyDown="TriggerBox_PreviewKeyDown" GotKeyboardFocus="Recorder_GotFocus" LostKeyboardFocus="Recorder_LostFocus" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock x:Name="HoldLabel" Style="{StaticResource Field}" Margin="0,0,0,3" />
                        <Slider x:Name="HoldSlider" Width="150" Minimum="100" Maximum="800" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="Sliders_Changed" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock x:Name="FolderLabel" Style="{StaticResource Field}" Margin="0,0,0,3" />
                        <Slider x:Name="FolderSlider" Width="150" Minimum="150" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="Sliders_Changed" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock x:Name="CenterLabel" Style="{StaticResource Field}" Margin="0,0,0,3" />
                        <Slider x:Name="CenterSlider" Width="150" Minimum="28" Maximum="90" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="Sliders_Changed" />
                    </StackPanel>
                    <CheckBox x:Name="StartupCheck" Content="Lancer avec Windows" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
